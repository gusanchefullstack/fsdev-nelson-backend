# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL=postgresql://user:password@host/neondb?sslmode=require
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL where the API is reached (through the frontend rewrite in production)
BETTER_AUTH_URL=http://localhost:5173
# Frontend origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:5173
# Vercel Blob token for avatar uploads (optional locally)
BLOB_READ_WRITE_TOKEN=
